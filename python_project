import random
import os
# keeps track of score

import datetime

# keep record of each attempt

# score count

SCORE_FILE = "best.score.txt"

# dictionary that stores difficulty settings
Game_Modes = {
    "1": {
        "name": "Simple",
        "minimum": 1,
        "maximum": 50,
        "attempts": 8,
    },

    "2": {
        "name": "Normal",
        "minimum": 1,
        "maximum": 100,
        "attempts": 6,
    },

    "3": {
        "name": "Complex",
        "minimum": 1,
        "maximum": 500,
        "attempts": 4
    }
}


def display_title():
    print("\n================================")
    print("      Welcome to Numble!        ")
    print("================================")
    print("I am thinking of a number!")
    print("Can you try to guess it?")


def display_modes():
    print("\nPick your skill level")
    print("-" * 30)

    print("1. Simple Mode")
    print("   Number range 1-50")
    print("   Attempts: 8")

    print()
    print("2. Normal Mode")
    print("   Number range 1-100")
    print("   Attempts: 6")

    print()

    print("3. Complex Mode")
    print("   Number range 1-500")
    print("   Attempts: 4")

    print("-" * 30)


# Loads and stores the previous scores
def load_best_scores():
    best_scores = {
        "Simple": None,
        "Normal": None,
        "Complex": None
    }

    if os.path.exists(SCORE_FILE):  # check if high score is here
        try:
            with open(SCORE_FILE, "r") as file:  # opens file in read mode
                for line in file:  # read each saved line
                    line = line.strip()  # remove unnecessary spaces
                    if not line:
                        continue  # ignore empty line
                    parts = line.split("|")  # separate saved info
                    if len(parts) == 4:
                        mode = parts[0]
                        try:
                            score = int(parts[1])
                            player = parts[2]
                            date = parts[3]  # only load recognized difficulty mode
                            if mode in best_scores:
                                if (
                                    best_scores[mode] is None
                                    or score > best_scores[mode]["score"]
                                ):
                                    best_scores[mode] = {
                                        "score": score,
                                        "player": player,
                                        "date": date
                                    }

                        except ValueError:  # skips corrupted scores
                            continue

        except OSError:
            print("Oh, something went wrong could not read score file.")


    return best_scores


def save_best_score(best_scores):
    try:
        with open(SCORE_FILE, "w") as file:
            for mode, information in best_scores.items():

                if information is not None:
                    score = information["score"]
                    player = information["player"]
                    date = information["date"]

            file.write(
                f"{mode}|{score}|{player}|{date}\n"
            )

        print("\nBest scores have been locked in!")

    except OSError:
        print("\nOh, something went wrong could not save scores.")


def display_best_scores(best_scores):
    print("\n")
    print("=" * 35)
    print("           Best Scores")
    print("=" * 35)

    for mode, information in best_scores.items():
        print(f"\n{mode.upper()} MODE")

        if information is not None:
            print("Best Score:", information["score"])
            print("Player:", information["player"])
            print("Date:", information["date"])

        else:
            print("No recorded scores yet.")

    print("=" * 35)


def get_player_name():
    while True:
        name = input("\nEnter your name: ").strip()

        if name:
            name = name.replace("|", "")
            return name

        else:
            print("Enter a valid name.")


def select_mode():
    display_modes()

    while True:
        choice = input(
            "\nPick your level (1, 2, or 3):"
        ).strip()

        if choice in Game_Modes:
            return Game_Modes[choice]

        else:
            print(
                "Invalid selection! "
                "Please choose 1, 2, or 3."
            )


def get_valid_guess(minimum, maximum):
    while True:
        guess = input("\nEnter your guess:").strip()

        try:
            number = int(guess)

        except ValueError:
            print("\nfYI!")
            print(
                "Please enter only numbers!"
                "Letters and symbols are not allowed."
            )
            continue

        if number < minimum or number > maximum:
            print("\nOut of Range!")

            print(
                f"Please enter a number between"
                f"{minimum} and {maximum}."
            )
            continue

        return number


def give_hint(guess, secret_number):
    if guess < secret_number:
        print("\nToo low! Try a HIGHER number.")

    elif guess > secret_number:
        print("\nToo high! Try a LOWER number.")

    else:
        print("\nYay! You guessed the right number!")


# calculating score
def calculate_score(total_attempts, attempts_used):
    base_score = 1000

    remaining_attempts = total_attempts - attempts_used

    bonus_points = remaining_attempts * 100

    final_score = base_score + bonus_points

    return final_score


def update_best_score(
        best_scores,
        mode,
        player,
        current_score
):
    current_date = datetime.datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    previous_record = best_scores[mode]

    if previous_record is None:
        print("\nNEW RECORD!")

        best_scores[mode] = {
            "score": current_score,
            "player": player,
            "date": current_date
        }

        return True

    elif current_score > previous_record["score"]:
        print("\nNEW HIGH SCORE!")

        print(
            "Congratulations, you have beaten the previous high score!"
        )

        best_scores[mode] = {
            "score": current_score,
            "player": player,
            "date": current_date
        }

        return True

    else:
        print("\nSorry, you did not beat the previous record.")

        print(
            "Previous Best Score:",
            previous_record["score"]
        )

        return False


def play_game(player, best_scores):
    selected_mode = select_mode()

    mode_name = selected_mode["name"]
    minimum = selected_mode["minimum"]
    maximum = selected_mode["maximum"]
    total_attempts = selected_mode["attempts"]

    secret_number = random.randint(minimum, maximum)

    attempts_used = 0
    won = False

    print("\n")
    print("=" * 35)

    print(f"WELCOME TO {mode_name.upper()} MODE!")

    print(f"Guess a number between {minimum} and {maximum}.")

    print(f"You have {total_attempts} attempts.")

    print("=" * 35)

    while attempts_used < total_attempts:
        remaining_attempts = (
                total_attempts - attempts_used
        )

        print("\nAttempts Remaining:", remaining_attempts)

        guess = get_valid_guess(minimum, maximum)

        attempts_used += 1

        give_hint(guess, secret_number)

        if guess == secret_number:
            won = True

            score = calculate_score(
                total_attempts,
                attempts_used
            )

            print("\n" + "=" * 35)

            print("             YOU WON!")

            print("=" * 35)

            print("Player:", player)
            print("Difficulty:", mode_name)
            print("Correct Number:", secret_number)
            print("Attempts Used:", attempts_used)
            print("Final Score:", score)

            update_best_score(
                best_scores,
                mode_name,
                player,
                score
            )

            save_best_score(best_scores)

            break

    if not won:
        print("\n" + "=" * 35)

        print("                 GAME OVER!")

        print("=" * 35)

        print("Sorry, you ran out of attempts.")
        print("The correct number was:", secret_number)
        print("Attempts Used:", attempts_used)
        print("Final Score: 0")

        print("\nSo Close!")

    display_best_scores(best_scores)


def play_again():
    while True:
        answer = input(
            "\n Give it another shot? (Y/N): "
        ).strip().lower()

        if answer in ["y", "yes"]:
            return True

        elif answer in ["n", "no"]:
            return False

        else:
            print(
                "Invalid response! "
                "Please enter Y or N."
            )


def main():
    display_title()

    best_scores = load_best_scores()

    player = get_player_name()

    print(f"\nWelcome, {player}!")

    display_best_scores(best_scores)

    continue_playing = True

    while continue_playing:
        play_game(player, best_scores)

        continue_playing = play_again()

    print("\n")
    print("=" * 35)

    print("       THANK YOU FOR PLAYING!")

    print("=" * 35)

    print(f"Goodbye, {player}!")

    print("Your best scores have been recorded.")

    print("Come back and try to beat your records!")

    print("=" * 35)


if __name__ == "__main__":
    main()




